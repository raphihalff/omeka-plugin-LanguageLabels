#: views/admin/plugins/language-labels-config-form.php:81
msgid "Colour by language"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:84
msgid "Give each language its own colour, derived from the base colour. When off, the label colours below are used."
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:97
msgid "Base colour"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:100
msgid "A hex colour, or a theme CSS variable with a hex fallback, e.g. var(--primary-color, #76D7C4). Other languages get the same shade in different hues."
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:113
msgid "Base language"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:116
msgid "Optional. Language shown in exactly the base colour, e.g. en or English."
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:127
msgid "Colour priority"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:130
msgid "Comma-separated languages, most common first. Earlier languages get the most distinct colours."
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:142
msgid "Label colours"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:145
msgid "Background and text hex colours, used when colour by language is off."
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:161
msgid "Custom labels"
msgstr ""

#: views/admin/plugins/language-labels-config-form.php:164
msgid "One \"value = label\" per line; case-insensitive. An empty label hides the value, e.g. \"zxx =\"."
msgstr ""

